rooms = {
    'A': 'Dirty',
    'B': 'Dirty'
}

location = 'A'

while True:
    print("Vacuum cleaner is in room", location)

    if rooms[location] == 'Dirty':
        print("Cleaning room", location)
        rooms[location] = 'Clean'

    if location == 'A':
        location = 'B'
    else:
        break

print("\nFinal Room Status:")
for room, status in rooms.items():
    print(room, ":", status)

print("All rooms are clean.")
